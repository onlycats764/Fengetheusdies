#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LUA_BIN=${LUA_BIN:-lua}

if ! command -v "$LUA_BIN" >/dev/null 2>&1; then
  echo "Error: no se encontró el intérprete Lua '$LUA_BIN'." >&2
  echo "Instálalo o define LUA_BIN con la ruta a un intérprete compatible." >&2
  exit 127
fi

exec "$LUA_BIN" "$SCRIPT_DIR/../src/cli.lua" "$@"
