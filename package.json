{
  "name": "fengetheus-web",
  "version": "1.2.0",
  "description": "Fengetheus — a client-side Lua obfuscator built on Prometheus and LuaNode-VM.",
  "private": true,
  "type": "module",
  "author": "Fengetheus",
  "license": "MIT",
  "scripts": {
    "build:modules": "node web/scripts/build-lua-modules.mjs",
    "build:bundle": "esbuild web/src/app.js --bundle --outfile=web/dist/bundle.js --format=iife --platform=browser --target=es2020 --alias:fs=./web/src/node-shims/fs.js --external:child_process --external:tmp --external:path --external:os --external:crypto --external:readline-sync --minify && esbuild web/src/worker.js --bundle --outfile=web/dist/worker.js --format=iife --platform=browser --target=es2020 --alias:fs=./web/src/node-shims/fs.js --external:child_process --external:tmp --external:path --external:os --external:crypto --external:readline-sync --minify",
    "build": "npm run build:modules && npm run build:bundle",
    "test": "node test/regression.mjs"
  },
  "dependencies": {
    "luanode-vm": "github:Xyraniz/LuaNode-VM"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
